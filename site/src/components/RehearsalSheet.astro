---
// Lines match examples/README.md and the retry demo (examples/retry/); keep them in sync.
const LINES = [
  { pass: true, text: 'R1: attempt 0 returns 1 second, covered by Task 1' },
  { pass: true, text: 'R2: the delay doubles, covered by Task 1' },
  { pass: false, text: 'R3: the 30-second cap has no task in the plan' },
  { pass: false, text: 'Acceptance check on the uncapped code failed: ', code: '64 != 30' },
  { pass: false, text: 'No independent review has run yet' },
];
---

<figure class="sheet not-content" aria-labelledby="pv-sheet-title">
  <header>
    <p class="title" id="pv-sheet-title">plan.md: retry delay (one phase, one task)</p>
    <p class="path">examples/retry</p>
  </header>
  <ol>
    {
      LINES.map(({ pass, text, code }) => (
        <li class={pass ? 'pass' : 'fail'}>
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              {pass ? <path d="m5 12.5 4.5 4.5L19 7.5" /> : <path d="M12 5v9m0 4.5v.5" />}
            </svg>
          </span>
          <span class="sr-only">{pass ? 'Pass: ' : 'Fail: '}</span>
          <span>
            {text}
            {code && <code>{code}</code>}
          </span>
        </li>
      ))
    }
  </ol>
  <p class="stamp">
    <span class="verdict">Not ready</span>
    <span class="reason">Missing cap and no review</span>
  </p>
  <figcaption>Authored example fixture, not a benchmark.</figcaption>
</figure>

<style>
  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0 1.5rem;
    max-width: 47.5rem;
    margin: 2.25rem 0 3.5rem;
    padding: 1.625rem 1.75rem 1.375rem;
    border: 1px solid var(--pv-line);
    border-radius: 1.25rem;
    background-color: var(--pv-surface);
    background-image: repeating-linear-gradient(transparent 0 2.4375rem, var(--pv-blush) 2.4375rem 2.5rem);
    background-position: 0 3.875rem;
    container-type: inline-size;
  }
  header,
  ol {
    grid-column: 1 / -1;
  }
  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: 0.875rem;
  }
  header p {
    margin: 0;
  }
  .title {
    color: var(--pv-ink);
    font: 700 1.0625rem var(--pv-font-display);
  }
  .path {
    color: var(--pv-muted);
    font: 0.75rem var(--pv-font-mono);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-height: 2.5rem;
    color: var(--pv-ink);
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
  }
  .mark svg {
    width: 0.875rem;
    height: 0.875rem;
  }
  .pass .mark {
    background: var(--pv-mint-tint);
    color: var(--pv-mint);
  }
  .fail {
    color: var(--pv-amber);
  }
  .fail .mark {
    background: var(--pv-amber-tint);
    color: var(--pv-amber);
  }
  code {
    padding: 0.0625rem 0.375rem;
    border-radius: 0.3125rem;
    background: var(--pv-amber-tint);
    font: 0.8125rem var(--pv-font-mono);
    font-variant-ligatures: none;
  }
  .stamp {
    grid-column: 2;
    grid-row: 3;
    margin: 0.875rem 0 0;
    padding: 0.5rem 1rem;
    border: 3px solid var(--pv-amber);
    border-radius: 0.625rem;
    background: var(--pv-surface);
    color: var(--pv-amber);
    transform: rotate(-8deg);
  }
  .verdict {
    display: block;
    font: 800 1.375rem var(--pv-font-display);
  }
  .reason {
    display: block;
    font: 600 0.75rem var(--pv-font-body);
  }
  figcaption {
    grid-column: 1;
    grid-row: 3;
    color: var(--pv-muted);
    font-size: 0.8125rem;
  }
  @container (max-width: 30rem) {
    .stamp,
    figcaption {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .stamp {
      justify-self: start;
      margin-bottom: 0.875rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    li .mark {
      animation: pv-pop 0.35s ease-out both;
    }
    li:nth-child(1) .mark { animation-delay: 0.3s; }
    li:nth-child(2) .mark { animation-delay: 0.6s; }
    li:nth-child(3) .mark { animation-delay: 0.9s; }
    li:nth-child(4) .mark { animation-delay: 1.2s; }
    li:nth-child(5) .mark { animation-delay: 1.5s; }
    .stamp {
      animation: pv-stamp 0.4s cubic-bezier(0.2, 1.6, 0.4, 1) 1.9s both;
    }
    @keyframes pv-pop {
      from { transform: scale(0); }
      to { transform: scale(1); }
    }
    @keyframes pv-stamp {
      from { opacity: 0; transform: rotate(-8deg) scale(1.6); }
      to { opacity: 1; transform: rotate(-8deg) scale(1); }
    }
  }
</style>
