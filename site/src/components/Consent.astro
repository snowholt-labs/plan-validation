---
// Google Analytics loads only after a visitor accepts. The banner lives in a <template> so the
// head override can carry it to every page; the static HTML never loads a third-party script.
import { withBase } from './icons';

const GA_ID = 'G-7435SD5GB9';
const privacy = withBase('safety-and-limitations/#website-analytics');
// Only the published site measures; dev, preview and forks keep the banner and loader switched off.
const site = import.meta.env.PROD && import.meta.env.SITE ? new URL(import.meta.env.SITE).origin : '';
---

<template id="pv-consent" data-ga-id={GA_ID} data-path={withBase('')} data-origin={site}>
  <section class="consent" aria-labelledby="pv-consent-title" data-pagefind-ignore>
    <p class="title" id="pv-consent-title">Analytics cookies</p>
    <p>
      May this site use Google Analytics cookies to measure visits and how its pages are used? Nothing loads unless you
      accept. <a href={privacy}>Privacy details</a>
    </p>
    <p class="status" id="pv-consent-status" hidden></p>
    <div class="actions">
      <button type="button" data-choice="granted">Accept</button>
      <button type="button" data-choice="denied">Decline</button>
    </div>
  </section>
</template>

<script>
  const KEY = 'pv-analytics-consent';
  const template = document.getElementById('pv-consent') as HTMLTemplateElement | null;
  const id = template?.dataset.gaId ?? '';
  // GA cookies stay on this site's path, so other github.io project sites on the origin are untouched.
  const cookiePath = template?.dataset.path ?? '/';
  let banner: HTMLElement | null = null;
  let returnFocus: HTMLElement | null = null;
  let resize: ResizeObserver | null = null;
  // The choice made on this page when storage could not save it.
  let memory: string | null = null;
  // The choice this page has applied, so applying it again sends no extra page view.
  let applied: 'granted' | 'denied' | null = null;

  type Gtag = (...args: unknown[]) => void;
  const w = window as unknown as Record<string, unknown> & { dataLayer?: unknown[]; gtag?: Gtag };

  function read() {
    // An unsaved choice from this page beats the older stored value.
    if (memory) return memory;
    try {
      return localStorage.getItem(KEY);
    } catch {
      // Blocked site data cannot keep a choice, so treat it as declined instead of asking on every page.
      return 'denied';
    }
  }

  function write(value: string) {
    memory = null;
    try {
      localStorage.setItem(KEY, value);
    } catch {
      memory = value;
      // Without storage the choice lasts for this page only; drop an older saved choice so it cannot return.
      try {
        localStorage.removeItem(KEY);
      } catch {
        // Storage is blocked entirely, and read() already treats that as declined.
      }
    }
  }

  function load() {
    w[`ga-disable-${id}`] = false;
    const config = { cookie_path: cookiePath, allow_google_signals: false, allow_ad_personalization_signals: false };
    if (w.gtag) {
      // Accepting again on a page where GA was revoked; config sends this page view once more.
      w.gtag('consent', 'update', { analytics_storage: 'granted' });
      w.gtag('config', id, config);
      return;
    }
    w.dataLayer = w.dataLayer || [];
    w.gtag = function gtag() {
      // gtag.js expects the arguments object itself, not an array.
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer!.push(arguments);
    };
    w.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'granted',
    });
    w.gtag('js', new Date());
    w.gtag('config', id, config);
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
    document.head.append(script);
  }

  // Stops GA on this page and removes this site's GA cookies; safe to run on every page that is not opted in.
  function revoke() {
    w[`ga-disable-${id}`] = true;
    w.gtag?.('consent', 'update', { analytics_storage: 'denied' });
    const names = document.cookie
      .split(';')
      .map((c) => c.split('=')[0].trim())
      .filter((n) => n === '_ga' || n.startsWith('_ga_'));
    for (const name of names) {
      for (const domain of ['', `; domain=${location.hostname}`, `; domain=.${location.hostname}`]) {
        document.cookie = `${name}=; max-age=0; path=${cookiePath}${domain}`;
      }
    }
  }

  function apply(choice: string | null) {
    const next = choice === 'granted' ? 'granted' : 'denied';
    if (next === applied) return;
    applied = next;
    if (next === 'granted') load();
    else revoke();
  }

  function hide() {
    if (!banner) return;
    const hadFocus = banner.contains(document.activeElement);
    banner.remove();
    banner = null;
    resize?.disconnect();
    document.body.style.paddingBottom = '';
    document.documentElement.style.scrollPaddingBottom = '';
    let target = returnFocus;
    returnFocus = null;
    if (!hadFocus) return;
    if (!target) {
      // The removed banner held focus; continue from the start of the main content.
      target = document.querySelector('main');
      if (target && !target.hasAttribute('tabindex')) {
        target.setAttribute('tabindex', '-1');
        target.addEventListener('blur', () => target!.removeAttribute('tabindex'), { once: true });
      }
    }
    target?.focus({ preventScroll: true });
  }

  function show(focus: boolean) {
    if (!template) return;
    if (!banner) {
      banner = (template.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLElement;
      // Early in the reading and tab order, inside the frame Starlight makes inert while its mobile menu is open.
      const frame = document.querySelector('.main-frame');
      if (frame) frame.prepend(banner);
      else document.body.prepend(banner);
      // Keep the end of the page, and anything scrolled into view, clear of the fixed banner.
      resize = new ResizeObserver(() => {
        if (!banner) return;
        const space = `${banner.offsetHeight + 32}px`;
        document.body.style.paddingBottom = space;
        document.documentElement.style.scrollPaddingBottom = space;
      });
      resize.observe(banner);
      banner.addEventListener('click', (event) => {
        const choice = (event.target as HTMLElement).closest('button')?.dataset.choice;
        if (!choice) return;
        write(choice);
        hide();
        apply(choice);
      });
      // Escape closes the settings panel without changing an existing choice.
      banner.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const stored = read();
        if (stored === 'granted' || stored === 'denied') hide();
      });
    }
    const stored = read();
    const status = banner.querySelector<HTMLElement>('.status')!;
    status.hidden = stored !== 'granted' && stored !== 'denied';
    status.textContent = stored === 'granted' ? 'Current choice: accepted.' : 'Current choice: declined.';
    for (const button of banner.querySelectorAll('button')) {
      if (status.hidden) button.removeAttribute('aria-describedby');
      else button.setAttribute('aria-describedby', status.id);
    }
    // Opened from Cookie settings: keep the panel next to its opener in the keyboard order.
    const spot = returnFocus?.closest('p');
    // Moving the panel would drop focus inside it, so move it only when it is elsewhere.
    if (spot && spot.nextElementSibling !== banner) spot.after(banner);
    if (focus) banner.querySelector('button')?.focus();
  }

  // Applies the stored choice and shows the banner only while no choice is recorded.
  function sync() {
    const choice = read();
    apply(choice);
    if (choice !== 'granted' && choice !== 'denied') show(false);
    // A panel the visitor opened through Cookie settings stays open and shows the new choice.
    else if (returnFocus) show(false);
    else hide();
  }

  if (id && template?.dataset.origin === location.origin) {
    sync();
    for (const opener of document.querySelectorAll<HTMLElement>('[data-pv-consent-open]')) opener.hidden = false;

    document.addEventListener('click', (event) => {
      const opener = (event.target as HTMLElement).closest<HTMLElement>('[data-pv-consent-open]');
      if (!opener) return;
      returnFocus = opener;
      show(true);
    });
    // A choice made in another tab, or a page restored from the back-forward cache, follows the stored choice.
    window.addEventListener('storage', (event) => {
      if (event.key !== KEY && event.key !== null) return;
      // Another tab saved a newer choice, so the one held for this page no longer applies.
      memory = null;
      sync();
    });
    window.addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      // The stored choice may have changed while this page was cached.
      memory = null;
      sync();
    });
  }
</script>

<style>
  .consent {
    position: fixed;
    inset-inline: 1rem;
    bottom: 1rem;
    /* Below Starlight's mobile menu (5), so an open menu covers the banner instead of the reverse. */
    z-index: 4;
    max-width: 34rem;
    /* At high zoom the banner scrolls inside half the viewport, so the page stays readable. */
    max-height: 50dvh;
    overflow-y: auto;
    margin-inline: auto;
    padding: 1rem 1.25rem;
    border: 1px solid var(--pv-border);
    border-radius: 0.875rem;
    background: var(--pv-surface);
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.28);
    color: var(--pv-ink);
    font-size: var(--sl-text-sm);
  }
  /* Beside the fixed left sidebar on wide pages, never over it. */
  @media (min-width: 50rem) {
    :global([data-has-sidebar]) .consent {
      inset-inline-start: calc(var(--sl-sidebar-width) + 1rem);
    }
  }
  /* Clear of the right-hand page rail where Starlight shows it. */
  @media (min-width: 72rem) {
    :global([data-has-toc]) .consent {
      inset-inline-end: calc(
        max(var(--sl-sidebar-width), var(--sl-sidebar-width) + (100vw - 2 * var(--sl-sidebar-width) - var(--sl-content-width)) / 2) +
          1rem
      );
    }
  }
  @media print {
    .consent {
      display: none;
    }
    :global(body) {
      padding-bottom: 0 !important;
    }
  }
  .consent p {
    margin: 0 0 0.75rem;
  }
  .consent .title {
    margin-bottom: 0.25rem;
    font: 700 1rem var(--pv-font-display);
  }
  .consent .status {
    color: var(--pv-muted);
  }
  .consent a {
    color: var(--pv-plum);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .actions button {
    flex: 1 1 8rem;
    padding: 0.5rem 1.125rem;
    border: 0;
    border-radius: 999px;
    background: var(--pv-plum);
    color: var(--pv-paper);
    font: 700 0.9375rem var(--pv-font-display);
    cursor: pointer;
  }
  .actions button:hover {
    background: var(--pv-plum-deep);
  }
  .consent a:focus-visible,
  .actions button:focus-visible {
    outline: 3px solid var(--pv-plum);
    outline-offset: 2px;
  }
</style>
