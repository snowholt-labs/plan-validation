---
// Google Analytics loads only after a visitor accepts. The banner lives in a <template> so the
// head override can carry it to every page; the static HTML never loads a third-party script.
const GA_ID = 'G-7435SD5GB9';
const privacy = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/safety-and-limitations/#website-analytics`;
---

<template id="pv-consent" data-ga-id={GA_ID}>
  <section class="consent" aria-labelledby="pv-consent-title" data-pagefind-ignore>
    <p class="title" id="pv-consent-title">Analytics cookies</p>
    <p>
      May this site use Google Analytics cookies to count visits and see which pages help? Nothing loads unless you
      accept. <a href={privacy}>Privacy details</a>
    </p>
    <div class="actions">
      <button type="button" data-choice="granted">Accept</button>
      <button type="button" data-choice="denied">Decline</button>
    </div>
  </section>
</template>

<script>
  const KEY = 'pv-analytics-consent';
  const template = document.getElementById('pv-consent') as HTMLTemplateElement | null;
  const id = template?.dataset.gaId ?? '';
  let banner: HTMLElement | null = null;
  let returnFocus: HTMLElement | null = null;

  type Gtag = (...args: unknown[]) => void;
  const w = window as unknown as Record<string, unknown> & { dataLayer?: unknown[]; gtag?: Gtag };

  function read() {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  function write(value: string) {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      // Without storage the choice lasts for this page only.
    }
  }

  function load() {
    w[`ga-disable-${id}`] = false;
    if (w.gtag) {
      w.gtag('consent', 'update', { analytics_storage: 'granted' });
      return;
    }
    w.dataLayer = w.dataLayer || [];
    w.gtag = function gtag() {
      // gtag.js expects the arguments object itself, not an array.
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer!.push(arguments);
    };
    w.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'granted',
    });
    w.gtag('js', new Date());
    w.gtag('config', id, { allow_google_signals: false, allow_ad_personalization_signals: false });
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
    document.head.append(script);
  }

  function revoke() {
    w[`ga-disable-${id}`] = true;
    w.gtag?.('consent', 'update', { analytics_storage: 'denied' });
    const names = document.cookie
      .split(';')
      .map((c) => c.split('=')[0].trim())
      .filter((n) => n === '_ga' || n.startsWith('_ga_'));
    for (const name of names) {
      for (const domain of ['', `; domain=${location.hostname}`, `; domain=.${location.hostname}`]) {
        document.cookie = `${name}=; max-age=0; path=/${domain}`;
      }
    }
  }

  function hide() {
    banner?.remove();
    banner = null;
    returnFocus?.focus();
    returnFocus = null;
  }

  function show(focus: boolean) {
    if (!template || banner) return;
    document.body.append(template.content.cloneNode(true));
    banner = document.body.lastElementChild as HTMLElement;
    banner.addEventListener('click', (event) => {
      const choice = (event.target as HTMLElement).closest('button')?.dataset.choice;
      if (!choice) return;
      write(choice);
      hide();
      if (choice === 'granted') load();
      else revoke();
    });
    if (focus) banner.querySelector('button')?.focus();
  }

  if (id) {
    const stored = read();
    if (stored === 'granted') load();
    else if (stored !== 'denied') show(false);

    document.addEventListener('click', (event) => {
      const opener = (event.target as HTMLElement).closest<HTMLElement>('[data-pv-consent-open]');
      if (!opener) return;
      returnFocus = opener;
      show(true);
    });
  }
</script>

<style>
  .consent {
    position: fixed;
    inset-inline: 1rem;
    bottom: 1rem;
    z-index: 30;
    max-width: 34rem;
    margin-inline: auto;
    padding: 1rem 1.25rem;
    border: 1px solid var(--pv-border);
    border-radius: 0.875rem;
    background: var(--pv-surface);
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 0.28);
    color: var(--pv-ink);
    font-size: var(--sl-text-sm);
  }
  .consent p {
    margin: 0 0 0.75rem;
  }
  .consent .title {
    margin-bottom: 0.25rem;
    font: 700 1rem var(--pv-font-display);
  }
  .consent a {
    color: var(--pv-plum);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .actions button {
    flex: 1 1 8rem;
    padding: 0.5rem 1.125rem;
    border: 0;
    border-radius: 999px;
    background: var(--pv-plum);
    color: var(--pv-paper);
    font: 700 0.9375rem var(--pv-font-display);
    cursor: pointer;
  }
  .actions button:hover {
    background: var(--pv-plum-deep);
  }
  .consent a:focus-visible,
  .actions button:focus-visible {
    outline: 3px solid var(--pv-plum);
    outline-offset: 2px;
  }
</style>
